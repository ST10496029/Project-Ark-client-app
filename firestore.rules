rules_version = '2';

// Firestore security rules. Paste into Firebase console -> Firestore -> Rules
// (or deploy with the Firebase CLI later). Shared with the driver app.
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}: each person can only see and edit their own profile.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // The customer app may only create customer profiles.
      // Driver profiles will be created/approved separately (driver app / admin).
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == "customer"
        && request.resource.data.phone == request.auth.token.phone_number
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60;

      // Name and language can change; role and phone can't.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "language"]);

      allow delete: if false;
    }
  }
}
